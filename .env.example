# Hugging-Face-Token (pyannote-Diarization). Lizenzen vorher akzeptieren:
#   https://huggingface.co/pyannote/speaker-diarization-community-1   (Standardmodell, pyannote 4.x)
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer-Token für Langdock (in der Custom MCP Integration als API-Key hinterlegen).
# Erzeugen mit:  openssl rand -hex 32
API_TOKEN=

# Optional — Defaults sind sinnvoll gesetzt.
MODEL=large-v3-turbo
COMPUTE_TYPE=float16
LANGUAGE=de
ENABLE_DIARIZATION=1
# Kleiner = weniger VRAM-Peak (wichtig, wenn die GPU mit anderen Prozessen geteilt wird).
BATCH_SIZE=8
